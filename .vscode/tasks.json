{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar Proyecto (Development Editor)",
            "type": "shell",
            "command": "ue-compile",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Abrir Unreal Editor",
            "type": "shell",
            "command": "ue-open",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Limpiar Cache (Clean)",
            "type": "shell",
            "command": "ue-clean",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        }
    ]
}
